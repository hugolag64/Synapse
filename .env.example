# Notion Configuration
NOTION_TOKEN=secret_...
DATABASE_COURS_ID=...
DATABASE_UE_ID=...
# Optionnel — valeurs par défaut utilisées si absents
DATABASE_ITEM_ID=
DATABASE_DAILY_ID=

# App Configuration
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Paris
SYNAPSE_ENV=prod
SYNAPSE_HOST=0.0.0.0
SYNAPSE_PORT=8000
SYNAPSE_HOST_PORT=8888
SYNAPSE_BIND_IP=0.0.0.0
MEDICINE_DIR=
FAC_DIR=

# Host directories mounted into the container (Ubuntu paths, not Windows paths)
OBSIDIAN_HOST_PATH=/srv/data/obsidian
MEDICINE_HOST_PATH=/srv/data/medicine
FAC_HOST_PATH=/srv/data/fac

# Obsidian Integration (optionnel)
OBSIDIAN_VAULT_PATH=
OBSIDIAN_VAULT_NAME=

# AnkiConnect is optional. Keep the default when Anki runs in the same machine.
# For a remote desktop, use a secured VPN/SSH tunnel; do not expose port 8765 publicly.
ANKI_CONNECT_URL=http://127.0.0.1:8765
ANKI_CONNECT_TIMEOUT_SECONDS=2.5

# Gemini model routing (optional)
GEMINI_API_KEY=
GEMINI_LITE_MODEL=gemini-3.1-flash-lite
GEMINI_FLASH_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_SECONDS=60
