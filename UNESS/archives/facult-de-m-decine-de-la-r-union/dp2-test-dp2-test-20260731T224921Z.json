{"schema_version": 1, "faculty": "Faculté de médecine de La Réunion", "level": "DFGSM2 - DFASM1", "year": 2024, "title": "DFASM1_UE5S7_CT_Hematologie_090224 — DP2", "dp_context": {"enonce_general": "Une patiente de 30 ans, se présente à votre consultation d’anesthésie durant son 3\nème\ntrimestre de grossesse afin de préparer son accouchement. Elle vous indique que quelques années auparavant avant l’extraction de ses dents de sagesse, l’anesthésiste aurait trouvé des anomalies sur son bilan mais elle ne se souvient plus des détails."}, "questions": [{"id": "question-16816836-2", "type_question": "DP", "enonce": "Quelle(s) question(s) vous semble(nt) pertinente(s) au vu de la situation ?", "propositions": [{"id": "a", "texte": "Recherche des antécédents chirurgicaux", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Essentiel pour évaluer le risque hémorragique per et post-opératoire.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "b", "texte": "Recherche des prises médicamenteuses", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Indispensable pour identifier des substances pouvant interférer avec l'hémostase.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "c", "texte": "Recherche de syndrome hémorragique", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "La recherche d'anomalies de l'hémostase nécessite d'interroger systématiquement sur des signes cliniques (épistaxis, ménorragies, etc.).", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "d", "texte": "Recherche d’antécédents familiaux hémorragiques", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "L'interrogatoire familial est crucial pour suspecter des pathologies héréditaires de l'hémostase.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "e", "texte": "Recherche d’antécédents familiaux de cancer", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Non pertinent pour l'évaluation spécifique du risque hémorragique lors d'une consultation d'anesthésie.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816836-3", "type_question": "DP", "enonce": "Quel(s) examen(s) lui demandez-vous en 1ère intention au vu du contexte ?", "propositions": [{"id": "a", "texte": "Hémogramme", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Examen de base pour éliminer une thrombopénie.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "b", "texte": "TP, TCA, Fibrinogène", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Bilan d'hémostase standard en pré-opératoire en cas de doute clinique.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "c", "texte": "Groupe sanguin ABO, Rhesus", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Indispensable pour toute patiente enceinte en vue d'un accouchement.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "d", "texte": "Dosage du facteur V", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Le dosage du facteur V n'est pas un examen de première intention.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "e", "texte": "Dosage du facteur XII", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Le déficit en facteur XII ne nécessite pas de dosage spécifique en première intention.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816836-4", "type_question": "DP", "enonce": "Quel(s) examen(s) complémentaire(s) lui demandez-vous dans ce contexte ?", "propositions": [{"id": "a", "texte": "Dosage du facteur V", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Le TP est normal, le facteur V n'est donc pas en cause.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "b", "texte": "Dosage du facteur VIII", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Le TCA est allongé (1.6), il faut doser les facteurs de la voie intrinsèque (VIII, IX, XI).", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "c", "texte": "Dosage du facteur IX", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Le TCA est allongé, le dosage du facteur IX fait partie du bilan d'allongement du TCA.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "d", "texte": "Recherche d’anticoagulant circulant", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Devant un TCA allongé, il faut éliminer la présence d'un anticoagulant circulant.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "e", "texte": "Dosage du Willebrand Antigène et activité Ristocétine", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "La maladie de Willebrand est une cause fréquente d'allongement du TCA et de syndrome hémorragique.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816836-5", "type_question": "DP", "enonce": "Quel est votre diagnostic ?", "propositions": [{"id": "a", "texte": "Patiente conductrice d’hémophilie A", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Un taux de FVIII à 35% avec un TCA allongé oriente vers une conductrice d'hémophilie A, le taux étant inférieur à la normale mais supérieur aux taux retrouvés chez les patients hémophiles sévères.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "b", "texte": "Suspicion de syndrome des anti-phospholipides", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "La recherche d'anticoagulant circulant est négative.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "c", "texte": "Patiente conductrice d’hémophilie B", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Le facteur IX est normal.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "d", "texte": "Maladie de Willebrand", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Les dosages du facteur Willebrand sont normaux dans l'énoncé.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}, {"id": "e", "texte": "Patiente carencée en vitamine K", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Le TP est normal.", "sources_ia": [], "confiance_ia": 1, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}], "provenance": {"source": "Gemini+UNESS", "source_url": "https://entrainement.uness.fr/annales/course/view.php?id=29106", "collected_at": "2026-07-31T22:49:41.430644+00:00", "collection_status": "submitted"}, "metadata": {"subject": "HÉMATOLOGIE", "exam_type": "partiel", "metadonnees_a_verifier": false}}
