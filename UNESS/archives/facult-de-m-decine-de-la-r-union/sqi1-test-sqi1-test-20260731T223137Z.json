{"schema_version": 1, "faculty": "Faculté de médecine de La Réunion", "level": "DFGSM3", "year": 2025, "title": "DFGSM3_UE10.S6_Digestif_2_200525 — SQI1", "dp_context": {}, "questions": [{"id": "question-16816822-1", "type_question": "QRM", "enonce": "Quelles sont les causes d’hyperferritinémie avec augmentation du stock en fer ?", "propositions": [{"id": "a", "texte": "Syndrome métabolique", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Le syndrome métabolique est associé à une hyperferritinémie mais n'entraîne pas systématiquement une surcharge en fer tissulaire au sens strict (c'est une anomalie du métabolisme).", "sources_ia": [], "confiance_ia": 0.9, "commentaire_desaccord": ""}, {"id": "b", "texte": "Hyperthyroïdie", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "L'hyperthyroïdie n'est pas une cause de surcharge martiale.", "sources_ia": [], "confiance_ia": 0.9, "commentaire_desaccord": ""}, {"id": "c", "texte": "Hémochromatose", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "L'hémochromatose est la cause génétique classique de surcharge en fer.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Hépatosidérose dysmétabolique", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Il s'agit d'une cause reconnue de surcharge martiale modérée associée au syndrome métabolique.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "e", "texte": "Consommation excessive d’alcool", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "L'alcool provoque une hyperferritinémie souvent par cytolyse ou inflammation, sans surcharge en fer majeure.", "sources_ia": [], "confiance_ia": 0.8, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-2", "type_question": "QRM", "enonce": "Dans quelle(s) portion(s) du tube digestif le fer est-il absorbé ?", "propositions": [{"id": "a", "texte": "estomac", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "L'absorption se fait en aval de l'estomac.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "jéjunum distal", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "L'absorption est maximale dans le duodénum et le jéjunum proximal.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "colon", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Le colon n'absorbe pas le fer.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "duodénum", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "C'est le site principal d'absorption du fer.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "e", "texte": "iléon", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "L'absorption est terminée avant l'iléon.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "f", "texte": "jéjunum proximal", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Le fer est absorbé dans le duodénum et le jéjunum proximal.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-3", "type_question": "QRU", "enonce": "L’hémochromatose primitive ou héréditaire est", "propositions": [{"id": "a", "texte": "une maladie organique conduisant à un manque de fer", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "C'est une maladie de surcharge et non de carence.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "une maladie génétique aboutissant à une surcharge de fer", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "La réponse 'c' est plus complète ou préférée dans la correction officielle, bien que celle-ci soit médicalement exacte. Desaccord sur le caractère exclusif.", "sources_ia": [], "confiance_ia": 0.5, "commentaire_desaccord": "La proposition B est médicalement vraie pour une hémochromatose génétique. La distinction avec C semble arbitraire."}, {"id": "c", "texte": "une maladie chronique amenant à une surcharge en fer", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Définition classique de l'hémochromatose.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "une maladie chronique génétique conduisant à un manque de fer", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Faux, c'est une surcharge.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-4", "type_question": "QRM", "enonce": "Dans le cas d’un RGO typique chez une patiente de 30 ans ayant des symptômes quotidiens peu invalidants, quelles sont les réponses vraies ?", "propositions": [{"id": "a", "texte": "Les IPP sont le traitement médicamenteux de référence du RGO", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Les IPP sont le traitement de choix.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "Les règles hygiéno-diététiques sont la première étape de la prise en charge", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Toujours préconisées en première intention.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Le traitement par IPP ne doit jamais être poursuivi au-delà de 28 jours", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Un traitement au long cours peut être nécessaire.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Une endoscopie œso-gastro-duodénale doit être réalisée en première intention", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Pas nécessaire en première intention si symptômes typiques sans signe d'alarme.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-5", "type_question": "QRM", "enonce": "Une patiente de 40 ans présente un ulcère duodénal non compliqué. Les biopsies montrent la présence d'Helicobacter pylori, mais il n’y a pas d’antibiogramme disponible. Quel traitement pouvez-vous proposer en première intention ?", "propositions": [{"id": "a", "texte": "Une association IPP- Amoxicilline-clarithromycine-metronidazole 14 jours", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "La trithérapie classique (ou quadrithérapie non bismuthée) est adaptée.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "Un traitement par inhibiteurs de la pompe à protons seuls pendant 4 semaines", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Insuffisant pour éradiquer H. pylori.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Une association IPP- Amoxicilline-clarithromycine 10 jours", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Déconseillé sans connaître la sensibilité à la clarithromycine.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Une association IPP- Amoxicilline 14 jours", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Insuffisant.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "e", "texte": "Une quadrithérapie bismuthée de 10 jours (Pylera + Omeprazole)", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Option de référence recommandée en première intention.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-6", "type_question": "QRU", "enonce": "Une patiente de 55 ans présente une gastrite liée à une maladie de Biermer. Quelles sont les propositions exactes?", "propositions": [{"id": "a", "texte": "La maladie de Biermer fait partie du spectre des néoplasies endocriniennes multiples.", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Non, c'est une maladie auto-immune.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "L’infection à Helicobacter pylori est associée au déclenchement de la maladie de Biermer", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "L'infection à H. pylori peut être associée à des gastrites atrophiques, mais la Biermer est spécifique.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Il existe une gastrite atrophique lors de la maladie de Biermer", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "C'est la lésion caractéristique de la Biermer.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "La carence en vitamine B12 se constitue rapidement et expose à des complications neurologiques graves", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "La carence est très lente car les réserves hépatiques sont massives.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "e", "texte": "Il existe un risque de tumeur neuroendocrine du pancréas", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Le risque est de tumeurs neuroendocrines gastriques (gastrinomes ou carcinoïdes), pas pancréatiques.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-7", "type_question": "QRM", "enonce": "Quelle(s) est(sont) la(les) proposition(s) exacte(s) ?", "propositions": [{"id": "a", "texte": "En cas d’anémie ferriprive associée à des rectorragies, le bilan endoscopique n’est pas nécessaire lorsqu’il existe une pathologie hémorroïdaire à l’examen clinique", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Si anémie ferriprive, coloscopie obligatoire pour éliminer une cause proximale.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "Le traitement de la constipation est essentiel en cas de pathologie hémorroïdaire", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "La constipation aggrave la maladie hémorroïdaire.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "La ligature élastique peut être réalisée chez un malade sous anticoagulant", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Contre-indication relative ou prudence maximale.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Le traitement de la maladie hémorroïdaire est réservé aux formes symptomatiques", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "On ne traite pas des hémorroïdes asymptomatiques.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "e", "texte": "La chirurgie hémorroïdaire consiste toujours à réséquer le tissu hémorroïdaire", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Il existe des techniques de désartériolisation ou de remise en tension.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-8", "type_question": "QRU", "enonce": "Parmi ces médicaments, lequel est à rechercher devant une diarrhée chronique?", "propositions": [{"id": "a", "texte": "Le fer oral", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Le fer colore les selles en noir, mais ne donne pas de diarrhée chronique fréquente.", "sources_ia": [], "confiance_ia": 0.8, "commentaire_desaccord": ""}, {"id": "b", "texte": "Les Inhibiteurs de l’enzyme de conversion", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Pas une cause fréquente.", "sources_ia": [], "confiance_ia": 0.9, "commentaire_desaccord": ""}, {"id": "c", "texte": "La metformine", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Cause classique et fréquente de diarrhée médicamenteuse.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Les contraceptifs oraux", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Non.", "sources_ia": [], "confiance_ia": 0.9, "commentaire_desaccord": ""}, {"id": "e", "texte": "Les anti-inflammatoires stéroïdiens", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Non.", "sources_ia": [], "confiance_ia": 0.9, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-9", "type_question": "QRM", "enonce": "Parmi les propositions suivantes, quelles sont les complications classiques de la pancréatite chronique ?", "propositions": [{"id": "a", "texte": "Transformation en tumeur endocrine", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "C'est l'adénocarcinome qui est à risque accru.", "sources_ia": [], "confiance_ia": 0.9, "commentaire_desaccord": ""}, {"id": "b", "texte": "Dénutrition", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Par insuffisance pancréatique exocrine.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Poussée de pancréatite aigue", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Complication possible.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Diabète secondaire", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Par insuffisance endocrinienne.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-10", "type_question": "QRM", "enonce": "Parmi les propositions suivantes, lesquelles sont des causes de pancréatite chronique ?", "propositions": [{"id": "a", "texte": "Hypertriglycéridémie", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Cause métabolique reconnue.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "Hyperphosphorémie", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Non.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Génétique", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Formes génétiques bien identifiées.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Consommation excessive d’alcool", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Cause la plus fréquente.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "e", "texte": "Hypercalcémie", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "L'hypercalcémie est un facteur de risque.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-11", "type_question": "QRU", "enonce": "L’examen complémentaire de référence pour le diagnostic de pancréatite chronique calcifiante est :", "propositions": [{"id": "a", "texte": "L’échographie abdominale", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Limité par les gaz intestinaux.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "La cholangiopancréatographie rétrograde endoscopique", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Invasive, utilisée pour le traitement.", "sources_ia": [], "confiance_ia": 0.8, "commentaire_desaccord": ""}, {"id": "c", "texte": "Le scanner abdomino-pelvien", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "L'examen de référence pour visualiser les calcifications.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "L’échoendoscopie", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Très sensible pour les formes débutantes sans calcifications.", "sources_ia": [], "confiance_ia": 0.8, "commentaire_desaccord": ""}, {"id": "e", "texte": "L’IRM pancréatique", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Excellente mais le scanner est souvent cité comme référence pour les calcifications.", "sources_ia": [], "confiance_ia": 0.8, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-12", "type_question": "QRM", "enonce": "A propos du diagnostic radiologique du carcinome hépatocellulaire, quels sont les signes signant un profile vasculaire typique :", "propositions": [{"id": "a", "texte": "Une artérialisation du nodule (« wash-in »)", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Signe typique au temps artériel.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "Un aspect de prise de contraste en motte", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Typique de l'hémangiome.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Une perte de l’apport portal (« wash-out)", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Signe typique au temps portal/tardif.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Une hyper-intensité T1", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Pas un critère de vascularisation.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-13", "type_question": "QRU", "enonce": "Parmi les propositions suivantes concernant le cholangiocarcinome, laquelle est exacte ?", "propositions": [{"id": "a", "texte": "Les parasitoses biliaires augmentent le risque de cholangiocarcinome", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Notamment les douves du foie.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "Le risque de cholangiocarcinome est augmenté en cas de polykystose rénale", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Pas de lien direct.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Il s’agit d’une tumeur fréquemment symptomatique au stade précoce", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "C'est une tumeur silencieuse souvent tardive.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Le risque de cholangiocarcinome n’est pas augmenté en cas de cirrhose", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "La CSP et la cirrhose augmentent le risque.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-14", "type_question": "QRM", "enonce": "Parmi les propositions suivantes, quels sont les traitements curatifs du carcinome hépatocellulaire ?", "propositions": [{"id": "a", "texte": "L’ablation percutanée de la tumeur par radiofréquence", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Traitement curatif pour les petits CHC.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "La chimio-embolisation artérielle hépatique", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Traitement palliatif.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "La résection chirurgicale", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Traitement curatif (ou greffe).", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Les thérapies anticancéreuses ciblées (anti-angiogéniques)", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Traitement systémique palliatif.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "e", "texte": "L’immunothérapie", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Traitement systémique palliatif.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-15", "type_question": "QRM", "enonce": "Parmi les propositions suivantes, quelle(s) modalité(s) d’imagerie est(sont) utile(s) à la caractérisation des TIPMP ?", "propositions": [{"id": "a", "texte": "TEP-scan au 18F-fluorodésoxyglucose", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Peu utile pour la caractérisation des TIPMP.", "sources_ia": [], "confiance_ia": 0.9, "commentaire_desaccord": ""}, {"id": "b", "texte": "Scanner abdominal avec injection de contraste", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Indispensable pour le bilan.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Cholangio-pancréatographie rétrograde endoscopique (CPRE)", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Rarement utile, invasive.", "sources_ia": [], "confiance_ia": 0.8, "commentaire_desaccord": ""}, {"id": "d", "texte": "Échoendoscopie bilio-pancréatique", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Excellente pour les lésions kystiques.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "e", "texte": "IRM abdominale avec reconstruction de Wirsungo-IRM", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Examen de choix.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-16", "type_question": "QRM", "enonce": "Concernant l’épidémiologie de l’adénocarcinome du pancréas, quelle(s) proposition(s) est(sont) vraie(s) ?", "propositions": [{"id": "a", "texte": "Le pronostic du cancer du pancréas est mauvais", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Survie à 5 ans très faible.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "L’âge moyen de survenue est entre 60 et 70 ans", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Cancer du sujet âgé.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "L’incidence du cancer du pancréas est en hausse", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Vrai.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Les hommes sont 2 fois plus concernées que les femmes", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "L'incidence est proche chez les deux sexes.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-17", "type_question": "QRU", "enonce": "Parmi les propositions suivantes (qui sont toutes des symptômes de cancer du pancréas), quel symptôme est spécifique des cancers de la tête du pancréas ?", "propositions": [{"id": "a", "texte": "Diabète récent", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Peut être vu dans n'importe quel cancer pancréatique.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "Amaigrissement", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Signe général.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Anorexie", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Signe général.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Ictère", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "L'ictère cholestatique par compression de la voie biliaire est caractéristique de la tête du pancréas.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "e", "texte": "Douleurs abdominales transfixiantes", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Plus fréquent dans les tumeurs du corps ou de la queue.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-18", "type_question": "QRM", "enonce": "Concernant l’infection spontanée du liquide d’ascite :", "propositions": [{"id": "a", "texte": "Elle est définie par un taux de leucocytes dans l’ascite > 250/mm3", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Attention à la subtilité : le seuil est > 250 PNN/mm3, pas leucocytes totaux.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "Elle peut être asymptomatique, et justifie une ponction d’ascite systématique chez tout patient avec ascite sur cirrhose hospitalisé.", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Tout à fait exact.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Il n’existe pas d’infection spontanée du liquide d’ascite chez les patients avec ascite sur carcinose péritonéale.", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "La définition implique un liquide d'ascite stérile au départ, donc non.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Le traitement repose sur une antibiothérapie IV ciblant les BGN, et son efficacité est contrôlé par une nouvelle ponction d’ascite à 48h.", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Correct.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "e", "texte": "Elle se complique fréquemment d’insuffisance rénale, une perfusion d’Albumine est donc indiquée à J1 et J3 en prévention du syndrome hépato-rénal.", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Correct.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-19", "type_question": "QRM", "enonce": "Concernant le cancer de l’œsophage (choisir les réponses exactes)", "propositions": [{"id": "a", "texte": "Se situe plutôt au niveau du tiers supérieur de l’œsophage pour les adénocarcinomes", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Les adénocarcinomes sont typiquement du tiers inférieur.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "Est un cancer fortement lié au tabac et à l’alcool pour les carcinomes épidermoïdes", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Vrai.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Peut être découvert suite à une hématémèse", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Possible mais rare.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "La présence d’un ganglion sus claviculaire gauche peut amener au diagnostic", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Ganglion de Troisier.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "e", "texte": "L’adénocarcinome se développe au dépend d’une muqueuse glandulaire", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Vrai (souvent sur endobrachyœsophage).", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "f", "texte": "Le reflux gastro œsophagien et l’obésité sont des facteurs de risque de cancer de l’œsophage plutôt localisés au niveau du tiers inférieur", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Vrai.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "g", "texte": "Touche plus souvent les hommes que les femmes", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Vrai.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "h", "texte": "La dysphagie est souvent progressive, d’abord pour les solides puis les liquides", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Clinique classique.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "i", "texte": "La perte de poids est rare lors du diagnostic", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Au contraire, très fréquente.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "j", "texte": "Un TEP scanner doit être réalisé pour le bilan d’extension dans tous les cas", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Pas systématique dans tous les cas.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-20", "type_question": "QRM", "enonce": "Concernant le cancer de l’estomac (choisir les réponses exactes)", "propositions": [{"id": "a", "texte": "- Il s’agit le plus souvent d’un adénocarcinome", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Vrai.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "- Le principal facteur de risque est l’infection à Helicobacter pylori", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Vrai.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "- Un ulcère gastrique doit toujours être biopsié au niveau des berges pour de pas méconnaitre un cancer", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Règle d'or.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "- La carence en B12 n’est jamais associée au cancer gastrique", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Si, en cas de gastrite atrophique associée.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "e", "texte": "- L’obésité est un facteur de risque", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Vrai, notamment pour le cardia.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-21", "type_question": "QRM", "enonce": "Les polypes du colon (choisir les réponses correctes)", "propositions": [{"id": "a", "texte": "- Correspondent le plus souvent à des adénomes", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Vrai.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "- Doivent être réséqués par voie endoscopique si possible", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Vrai, pour prévention du cancer.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "- Peuvent se transformer en cancer en moins de 6 mois", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "La séquence adénome-carcinome est lente (plusieurs années).", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "- La présence de polypes chez un patient doit conduire à un dépistage par coloscopie chez ses apparentés au premier degré", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Vrai selon le contexte et le nombre/type.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "e", "texte": "- Il existe des syndromes génétiques prédisposant à la survenue de polypes", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Vrai (ex: PAF, Lynch).", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-22", "type_question": "QRU", "enonce": "Quelle est la localisation la plus fréquente des diverticules coliques ?", "propositions": [{"id": "a", "texte": "Côlon transverse", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Non.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "Côlon droit", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Non.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Côlon sigmoïde", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Localisation préférentielle.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Rectum", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Très rare.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-23", "type_question": "QRU", "enonce": "Parmi les propositions suivantes, laquelle est un facteur de risque établi de la diverticulose colique ?", "propositions": [{"id": "a", "texte": "Régime riche en fibres", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "C'est plutôt un facteur protecteur.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "Jeûne prolongé", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Non.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Constipation chronique", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Facteur favorisant par augmentation de la pression intracolique.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Jeune âge", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "C'est une pathologie du sujet âgé.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-24", "type_question": "QRU", "enonce": "Quelle modalité d’imagerie est recommandée en première intention pour le diagnostic d’une diverticulite aiguë compliquée ?", "propositions": [{"id": "a", "texte": "Coloscopie", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Contre-indiquée en phase aiguë.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "Échographie abdominale", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Opérateur dépendant.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Scanner abdominopelvien avec injection", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Examen de référence.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Radiographie de l’abdomen sans préparation", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Peu utile sauf complication (pneumopéritoine).", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}, {"id": "question-16816822-25", "type_question": "QRU", "enonce": "Quel est le traitement de première ligne d’une diverticulite aiguë non compliquée ?", "propositions": [{"id": "a", "texte": "Chirurgie en urgence", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Non, pas pour une forme non compliquée.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "b", "texte": "Traitement symptomatique", "reponse_uness": true, "verdict_ia": true, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Les recommandations actuelles préconisent une abstention antibiotique dans les formes simples.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "c", "texte": "Antibiothérapie et régime pauvre en résidus", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Ancienne recommandation, réservée aux formes graves ou terrains à risque.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}, {"id": "d", "texte": "Corticothérapie", "reponse_uness": false, "verdict_ia": false, "reponse_finale": null, "statut": "concordant", "validation_utilisateur": false, "explication_ia": "Absolument contre-indiqué.", "sources_ia": [], "confiance_ia": 1.0, "commentaire_desaccord": ""}], "images": [], "support_visuel_seul": false, "verification_status": "verified", "dp_context": {}}], "provenance": {"source": "Gemini+UNESS", "source_url": "https://entrainement.uness.fr/annales/course/view.php?id=29562", "collected_at": "2026-07-31T22:32:13.840017+00:00", "collection_status": "submitted"}, "metadata": {"subject": "DIGESTIF", "exam_type": "partiel", "metadonnees_a_verifier": false}}
